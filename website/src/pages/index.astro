---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Screenshots from '../components/Screenshots.astro';
import RamComparison from '../components/RamComparison.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <Hero />
    <Screenshots />
    <RamComparison />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const motion = matchMedia('(prefers-reduced-motion: no-preference)');
  const panels = [...document.querySelectorAll('main > section, .site-footer')];
  let lastWheel = -Infinity;
  let distance = 0;
  let advanced = false;

  window.addEventListener('wheel', (event) => {
    if (!motion.matches || !event.cancelable || event.defaultPrevented ||
        event.ctrlKey || event.metaKey || event.altKey || event.shiftKey ||
        Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;

    const now = performance.now();
    if (now - lastWheel > 160) {
      distance = 0;
      advanced = false;
    }
    lastWheel = now;
    if (advanced) {
      event.preventDefault();
      return;
    }

    const index = panels.findIndex((panel) => {
      const { top, bottom, height } = panel.getBoundingClientRect();
      const offset = panel.matches('.site-footer') ? bottom - innerHeight : top;
      return Math.abs(offset) < 2 && height <= innerHeight + 1;
    });
    const next = index === -1 ? undefined : panels[index + Math.sign(event.deltaY)];
    if (!next) return;

    // Let a deliberate wheel gesture advance once, including its momentum.
    event.preventDefault();
    distance += event.deltaY;
    if (event.deltaMode === 0 && Math.abs(distance) < 48) return;
    advanced = true;
    next.scrollIntoView({
      block: next.matches('.site-footer') ? 'end' : 'start',
      behavior: 'smooth',
    });
  }, { passive: false });
</script>
