---
import { ramComparison } from '../data/ram';
import { createComparison, states, type ComparisonData } from '../lib/ram';

interface Props {
  data?: ComparisonData;
}

const { data = ramComparison } = Astro.props;
const comparison = createComparison(data);
---

<section class="ram-comparison" aria-labelledby="ram-heading">
  <div class="wrap">
    <h2 id="ram-heading">{comparison.heading}</h2>
    <div class="ram-legend">
      {states.map((state) => <span class={state.id}>{state.name}</span>)}
    </div>
    <ul class="ram-columns" role="list" style={`--app-count: ${comparison.bars.length}`}>
      {comparison.bars.map((bar) => {
        const { menuOpen, menuClosed } = bar;
        const openHeight = menuOpen?.percent ?? 0;
        const closedHigher = menuOpen !== null && menuClosed.percent > openHeight;
        const equalHeight = menuOpen?.percent === menuClosed.percent;
        const sharedLabel = equalHeight && menuOpen?.label === menuClosed.label;
        return (
          <li
            class:list={['ram-column', { ours: bar.ours, striped: equalHeight || !menuOpen, 'closed-higher': closedHigher }]}
            style={`--open: ${openHeight}; --closed: ${menuClosed.percent}`}
          >
            <a class="ram-label" href={bar.url} target="_blank" rel="noopener noreferrer">
              {bar.name}
            </a>
            <div class="ram-bar" aria-hidden="true"></div>
            <span class:list={['ram-amount', { 'ram-amount-side': closedHigher }]}>
              {menuOpen && (
                <span class="ram-sr-only">{sharedLabel ? 'Menu open and closed: ' : 'Menu open: '}</span>
              )}
              {(menuOpen ?? menuClosed).label}
            </span>
            {menuOpen && !sharedLabel && (
              <span class:list={['ram-amount ram-amount-closed', { 'ram-amount-side': !closedHigher }]}>
                <span class="ram-sr-only">Menu closed: </span>
                {menuClosed.label}
              </span>
            )}
            {!menuOpen && <span class="ram-overlay-only">Overlay only</span>}
          </li>
        );
      })}
    </ul>
    {data.status === 'measured' && (
      <div class="ram-method">
        <p>Overlay active in both tests. Measured on {data.testedOn}.</p>
        <details>
          <summary>Test setup</summary>
          <p>{data.method}</p>
          <p>{data.system}</p>
          <p>
            {data.apps.map((app) => `${app.id} ${app.version}`).join(' · ')}
          </p>
        </details>
      </div>
    )}
  </div>
</section>

<style>
  .ram-comparison {
    --ram-open: #81858a;
    --ram-closed: var(--p-accent);
    padding: 32px 0 96px;
  }
  h2 {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -1px;
    margin: 0 0 28px;
  }
  .ram-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    color: var(--p-muted);
    font-size: 14px;
  }
  .ram-legend span {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ram-legend span::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--ram-open);
  }
  .ram-legend .menuClosed::before {
    background: var(--ram-closed);
  }
  .ram-columns {
    --plot-height: clamp(12.5rem, 43vw, 30rem);
    --bar-width: min(38%, 8.5rem);
    display: grid;
    grid-template-columns: repeat(var(--app-count), minmax(0, 1fr));
    list-style: none;
    padding: 56px 0 0;
    margin: 0;
  }
  .ram-column {
    --higher: max(var(--open), var(--closed));
    --lower: min(var(--open), var(--closed));
    --lower-color: var(--ram-closed);
    --upper-color: var(--ram-open);
    position: relative;
    display: grid;
    justify-items: center;
    grid-template-rows: var(--plot-height) max-content;
    min-width: 0;
  }
  .ram-column.closed-higher {
    --lower-color: var(--ram-open);
    --upper-color: var(--ram-closed);
  }
  .ram-bar {
    --split: calc(var(--lower) / var(--higher) * 100%);
    grid-row: 1;
    align-self: end;
    width: var(--bar-width);
    height: calc(var(--higher) * 1%);
    border-radius: 6px 6px 0 0;
    background: linear-gradient(to top, var(--lower-color) var(--split), var(--upper-color) var(--split));
  }
  .ram-column.striped .ram-bar {
    background: repeating-linear-gradient(
      135deg,
      var(--ram-open) 0 8px,
      var(--ram-closed) 8px 16px
    );
  }
  .ram-amount {
    position: absolute;
    top: calc(var(--plot-height) * (100 - var(--higher)) / 100 - .5rem);
    left: 50%;
    transform: translate(-50%, -100%);
    font-size: clamp(.875rem, 1.8vw, 1.25rem);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ram-amount-closed {
    color: var(--ram-closed);
  }
  .ram-overlay-only {
    grid-row: 3;
    color: var(--p-muted);
    text-align: center;
    font-size: .875rem;
  }
  .ram-label {
    grid-row: 2;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 6px;
    padding-inline: 4px;
    text-align: center;
    font-size: clamp(.875rem, 1.6vw, 1.125rem);
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .ram-label:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ram-column.ours .ram-label {
    color: var(--ram-closed);
  }
  .ram-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .ram-method {
    color: #aeb0b4;
    font-size: 13px;
    line-height: 1.65;
    margin: 24px 0 0;
    max-width: 800px;
  }
  .ram-method details {
    margin-top: 8px;
  }
  .ram-method summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ram-method details p {
    margin: 0 0 8px;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .ram-columns {
        view-timeline: --ram-chart block;
      }
      .ram-bar {
        transform-origin: bottom;
        /* Longhands prevent the build from folding the timeline into unsupported shorthand. */
        animation-name: ram-grow;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: --ram-chart;
        animation-range: entry 20% entry 90%;
      }
      .ram-amount {
        animation-name: ram-amount-enter;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: --ram-chart;
        animation-range: entry 55% entry 95%;
      }
    }
  }
  @keyframes ram-grow {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  @keyframes ram-amount-enter {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (width >= 980px) {
    .ram-amount-side {
      top: calc(var(--plot-height) * (100 - var(--lower)) / 100);
      left: calc(50% + var(--bar-width) / 2 + .75rem);
      transform: translateY(-50%);
    }
  }
  @media (width < 980px) {
    .ram-amount-closed {
      grid-row: 3;
      position: static;
      transform: none;
    }
  }
  @media (width < 640px) {
    .ram-comparison {
      padding-block: 24px 64px;
    }
    h2 {
      font-size: 24px;
      margin-bottom: 20px;
    }
    .ram-label,
    .ram-amount,
    .ram-overlay-only {
      font-size: .75rem;
    }
  }
</style>
