---
import { site } from '../data/site';
import ExternalArrow from './ExternalArrow.astro';
import CrosshairGallery from './CrosshairGallery.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="hero-text">
      <h1 id="hero-title">
        A crosshair overlay
        <br /> <span>for Windows.</span>
      </h1>
      <p class="hero__lead">Free to use and light on memory.</p>
      <div class="btn-row">
        <a
          class="btn btn--primary"
          data-download
          href={site.download}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={import.meta.env.BASE_URL + "assets/icons/download.svg"} width="18" height="18" alt="" />
          Download for Windows
        </a>
        <a
          class="source-link"
          href={site.repository}
          target="_blank"
          rel="noopener noreferrer"
        >
          View source <ExternalArrow />
        </a>
      </div>
    </div>

    <CrosshairGallery />
    <a class="scroll-link" href="#screenshots">
      Explore the app <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<script>
  import '../scripts/download';
</script>

<style>
  .hero {
    display: grid;
    align-content: center;
    min-height: 100dvh;
    padding: clamp(128px, 15svh, 176px) 0 56px;
  }
  .hero-text {
    text-align: center;
  }
  .hero h1 {
    margin: 0 auto;
    font-size: clamp(42px, 5.3vw, 76px);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.052em;
    max-width: 950px;
  }
  .hero h1 > span {
    color: #9c9da0;
  }
  .hero__lead {
    max-width: 540px;
    margin: 24px auto 0;
    font-size: 17px;
    line-height: 1.7;
    color: #bec0c2;
    font-weight: 400;
  }
  .hero .btn-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    margin-top: 32px;
  }
  .hero .btn {
    display: inline-flex;
    gap: 10px;
    height: 48px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .btn--primary img {
    width: 18px;
    height: 18px;
    filter: brightness(0);
  }
  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    font-size: 14px;
    font-weight: 500;
    color: #d5d5d6;
    text-decoration: none;
  }
  .source-link span {
    font-size: 18px;
    color: #999;
  }
  .btn {
    align-items: center;
    justify-content: center;
    background: var(--p-accent);
    color: var(--p-bg);
    text-decoration: none;
    transition:
      transform 0.15s,
      filter 0.15s;
  }
  .btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.07);
  }
  .btn:active {
    transform: translateY(0) scale(0.98);
  }
  .source-link {
    border-bottom: 1px solid #393b3e;
    transition: border-color 0.15s;
  }
  .source-link:hover {
    border-color: var(--p-ink);
  }
  .scroll-link {
    display: flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    min-height: 44px;
    margin: 24px auto 0;
    color: var(--p-muted);
    font-size: 12px;
    text-decoration: none;
    transition: color 0.2s;
  }
  .scroll-link span {
    transition: transform 0.2s;
  }
  .scroll-link:is(:hover, :focus-visible) {
    color: var(--p-ink);
  }
  .scroll-link:is(:hover, :focus-visible) span {
    transform: translateY(3px);
  }
  .hero-text {
    animation: hero-enter 0.6s ease-out both;
  }
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 1023px) {
    .hero h1 {
      font-size: 64px;
    }
  }
  @media (width >= 640px) and (height < 850px) {
    .hero {
      padding-block: calc(var(--header-clearance) + 16px) 24px;
    }
    .hero h1 {
      font-size: clamp(40px, 7.7dvh, 64px);
    }
    .hero__lead {
      margin-top: 16px;
    }
    .hero .btn-row {
      margin-top: 20px;
    }
    .scroll-link {
      margin-top: 12px;
    }
  }
  @media (max-width: 639px) {
    .hero {
      padding: 112px 0 40px;
    }
    .hero h1 {
      font-size: clamp(34px, 8.6vw, 54px);
      line-height: 1.14;
      letter-spacing: -0.052em;
    }
    .hero__lead {
      font-size: 15px;
      line-height: 1.7;
      margin-top: 22px;
      max-width: 330px;
    }
    .hero .btn-row {
      flex-direction: column;
      gap: 8px;
      margin-top: 26px;
    }
    .hero .btn {
      width: 100%;
      max-width: 290px;
      font-size: 14px;
    }
    .source-link {
      min-height: 44px;
      font-size: 13px;
    }
  }
</style>
