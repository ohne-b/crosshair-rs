export global Theme {
    in-out property <float> text-scale: 1;
    in-out property <bool> animations: false;
    in-out property <color> canvas: #171717;
    in-out property <color> preview: #141414;
    in-out property <color> panel: #1E1E1E;
    in-out property <color> field: #252525;
    in-out property <color> raised: #292929;
    in-out property <color> hover: #333333;
    in-out property <color> border: #303030;
    in-out property <color> text: #F4F4F5;
    in-out property <color> muted: #A1A1AA;
    in-out property <color> orange: #F97316;
    in-out property <color> on-accent: #181818;
    out property <length> radius: 8px;
}
