export struct PresetRow { id: string, name: string, thumbnail: image, selected: bool, favorite: bool }
export struct PresetGroup { items: [PresetRow] }
export struct LayerRow { id: string, name: string, kind: string, selected: bool, shown: bool, locked: bool }
export struct FieldRow { selection: string, key: string, label: string, value: string, kind: int, minimum: float, maximum: float, step: float, pixel-size: bool, numeric: float, checked: bool, choices: [string], selected: int, swatch: color, reset: bool }
export struct FieldGroup { first: FieldRow, second: FieldRow, paired: bool }
export struct BindingRow { direction: string, id: string, name: string, action: string, target: string, target-index: int, chord: string, enabled: bool, shortcut: bool, global: bool }
export struct CanvasViewport { left: float, top: float, right: float, bottom: float, scale: float }
export struct CanvasTile { x: float, y: float, width: float, height: float, bitmap: image }
export struct SelectionBounds { x: float, y: float, width: float, height: float, rotation: float, active: bool }
export struct CanvasHandle { sx: float, sy: float, rotate: bool, descending: bool }

export global Store {
    in-out property <bool> keyboard-navigation: false;
    in-out property <float> work-width: 1280;
    in-out property <float> work-height: 800;
    in-out property <bool> wide: true;
    in-out property <bool> window-maximized: false;
    in-out property <int> caption-hover: -1;
    in-out property <[PresetRow]> selector-presets;
    in-out property <[PresetRow]> layer-presets;
    in-out property <string> selector-search;
    in-out property <bool> selector-favorites: false;
    in-out property <int> selector-total: 0;
    in-out property <int> selector-favorite-count: 0;
    in-out property <int> page: 0;
    in-out property <int> settings-category: 0;
    in-out property <bool> connected: false;
    in-out property <bool> read-only: false;
    out property <bool> interactive: !root.read-only && (root.modal-kind == 0 || root.modal-kind == 3 || root.modal-kind == 5);
    in-out property <string> error;
    in-out property <string> activity;
    in-out property <bool> request-shortcut: false;
    in-out property <string> pending-shortcut;
    in-out property <bool> dirty: false;
    in-out property <bool> save-paused: false;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> visible: false;
    in-out property <string> visibility-shortcut;
    in-out property <string> visibility-reason;
    in-out property <[string]> profiles;
    in-out property <int> profile-index: 0;
    in-out property <image> active-thumbnail;
    in-out property <image> preview-thumbnail;
    in-out property <string> active-name;
    in-out property <[PresetRow]> presets;
    in-out property <[PresetGroup]> preset-groups;
    in-out property <int> library-columns: 4;
    in-out property <bool> browsing: false;
    in-out property <bool> browse-saving: false;
    in-out property <string> browse-saved;
    in-out property <string> dragged-preset;
    in-out property <int> preset-drop-index: -1;
    in-out property <string> search;
    in-out property <bool> favorites: false;
    in-out property <int> sort: 0;
    in-out property <int> total-presets: 0;
    in-out property <int> favorite-presets: 0;
    in-out property <string> document-name;
    in-out property <string> document-id;
    in-out property <bool> document-active: true;
    in-out property <string> inspector-selection;
    in-out property <bool> animate: false;
    in-out property <int> animation-trigger: 1;
    in-out property <bool> single-selection: false;
    in-out property <bool> has-animation: false;
    in-out property <bool> animation-target-needed: false;
    in-out property <bool> can-preview-aim: false;
    in-out property <bool> can-preview-fire: false;
    in-out property <bool> can-preview-movement: false;
    in-out property <bool> animation-playing: false;
    in-out property <bool> document-open: false;
    in-out property <bool> selection-editable: false;
    in-out property <[LayerRow]> layers;
    in-out property <[FieldGroup]> fields;
    in-out property <CanvasViewport> canvas-view;
    callback viewport-changed();
    changed canvas-view => { self.viewport-changed(); }
    in-out property <[CanvasTile]> canvas-tiles;
    in-out property <SelectionBounds> selection-bounds;
    public pure function canvas-handle-at(w: length, h: length, angle: angle, dx: length, dy: length) -> CanvasHandle {
        let x = dx * cos(angle) + dy * sin(angle);
        let y = dy * cos(angle) - dx * sin(angle);
        if abs(x) < 7px && abs(y + h / 2 + 21px) < 7px { return { rotate: true }; }
        // Keep the middle of even a one-pixel selection available for moving.
        let ex = abs(x) - w / 2;
        let ey = abs(y) - h / 2;
        if ex < -min(7px, w / 4) || ex > 7px || ey < -min(7px, h / 4) || ey > 7px { return {}; }
        let sx = x < 0px ? -1 : 1;
        let sy = y < 0px ? -1 : 1;
        // Opposite corners use the same screen diagonal, including at quarter turns.
        let vx = w * cos(angle) - sx * sy * h * sin(angle);
        let vy = w * sin(angle) + sx * sy * h * cos(angle);
        return { sx: sx, sy: sy, descending: (vx < 0px) == (vy < 0px) };
    }
    in-out property <float> zoom: 8;
    in-out property <float> pan-x;
    in-out property <float> pan-y;
    in-out property <bool> drawing: false;
    in-out property <float> brush-size: 2;
    in-out property <string> brush-color: "#F97316FF";
    in-out property <color> brush-swatch: #F97316;
    in-out property <[BindingRow]> bindings;
    in-out property <[BindingRow]> movement-bindings;
    in-out property <string> capture-id;
    in-out property <int> aim-action: 0;
    in-out property <string> aim-target;
    in-out property <string> aim-target-name;
    in-out property <int> aim-target-index: -1;
    in-out property <string> action-profile;
    in-out property <int> action-type: 0;
    in-out property <[string]> preset-names;
    in-out property <[image]> preset-thumbnails;
    in-out property <int> target-index: 0;
    in-out property <[string]> monitors;
    in-out property <int> monitor-index: 0;
    in-out property <int> output-mode: 0;
    in-out property <float> output-scale: 1;
    in-out property <float> output-x: 0;
    in-out property <float> output-y: 0;
    in-out property <[string]> positions;
