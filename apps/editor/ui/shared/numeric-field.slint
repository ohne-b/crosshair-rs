import { Theme } from "tokens.slint";
import { Store } from "models.slint";

export component NumericField inherits Rectangle {
    in property <string> identity;
    in property <string> label;
    in property <image> icon;
    in property <string> suffix;
    in property <bool> enabled: Store.interactive;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> value;
    callback changed(float, int);
    property <bool> editing: false;
    property <bool> dragging: false;
    property <length> start-x;
    property <physical-length> physical-delta: touch.mouse-x - root.start-x;
    property <float> start-value;
    property <float> drag-value;
    changed identity => { root.editing = false; root.dragging = false; }
    height: max(32px, 12px * Theme.text-scale + 16px);
    min-width: 0px; vertical-stretch: 0;
    border-radius: Theme.radius;
    background: touch.has-hover || focus.has-focus ? Theme.raised : Theme.field;
    border-width: root.editing ? 1px : 0px; border-color: Theme.orange;
    opacity: root.enabled ? 1 : 0.4;
    forward-focus: focus;
    function begin-edit() {
        root.start-value = root.value; root.editing = true;
        input.text = Store.format-number(root.value); input.focus(); input.select-all();
    }
    function commit() {
        if root.editing {
            root.editing = false;
            let value = input.text.is-float() ? clamp(round(input.text.to-float() / root.step) * root.step, root.minimum, root.maximum) : root.value;
            root.changed(value, 2);
        }
    }
    function nudge(amount: float) {
        root.changed(clamp(root.value + amount * root.step, root.minimum, root.maximum), 2);
    }
    Image { x: 9px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: root.icon; colorize: Theme.muted; }
    Text { visible: !root.editing; x: root.icon.width > 0 ? 32px : 9px; width: parent.width - self.x - 9px; height: parent.height;
        text: Store.format-number(root.dragging ? root.drag-value : root.value) + root.suffix; horizontal-alignment: right; vertical-alignment: center;
        color: Theme.text; font-size: 12px * Theme.text-scale; overflow: elide;
    }
    focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.begin-edit(); return accept; }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.nudge(-1); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.nudge(1); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && !root.editing; mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel && root.dragging { root.dragging = false; root.changed(root.drag-value, 2); }
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down { focus.focus(); root.start-x = self.mouse-x; root.start-value = root.value; root.drag-value = root.value; root.dragging = false; }
                if event.kind == PointerEventKind.up {
                    if root.dragging { root.dragging = false; root.changed(root.drag-value, 2); }
                    else { root.begin-edit(); }
                }
            }
        }
        moved => {
            if self.pressed && (root.dragging || abs(self.mouse-x - root.start-x) >= 3px) {
                root.dragging = true;
                root.drag-value = clamp(root.start-value + round(root.physical-delta / 1phx) * root.step, root.minimum, root.maximum);
                root.changed(root.drag-value, 1);
            }
        }
    }
    input := TextInput {
        visible: root.editing; enabled: root.enabled;
        x: root.icon.width > 0 ? 32px : 9px; width: parent.width - self.x - 9px; height: parent.height;
        single-line: true; horizontal-alignment: right; vertical-alignment: center;
        color: Theme.text; font-size: 12px * Theme.text-scale;
        selection-background-color: Theme.orange; selection-foreground-color: Theme.on-accent;
        accessible-label: root.label;
        changed has-focus => { if !self.has-focus { root.commit(); } }
        accepted => { root.commit(); focus.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.editing = false; focus.focus(); return accept; }
            if event.modifiers.control && !event.modifiers.alt && (event.text == "s" || event.text == "S") { root.commit(); focus.focus(); }
            return reject;
        }
    }
    accessible-role: spinbox; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-value: root.value; accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum; accessible-value-step: root.step;
    accessible-action-increment => { if root.enabled { root.nudge(1); } }
    accessible-action-decrement => { if root.enabled { root.nudge(-1); } }
    accessible-action-set-value(value) => { if root.enabled && value.is-float() { root.changed(clamp(round(value.to-float() / root.step) * root.step, root.minimum, root.maximum), 2); } }
}
