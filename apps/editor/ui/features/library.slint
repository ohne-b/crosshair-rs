import { DropDown } from "../shared/dropdown.slint";
import { ListView } from "std-widgets.slint";
import { Store } from "../shared/models.slint";
import { Theme } from "../shared/tokens.slint";
import { ActionButton, EditField, Divider } from "../shared/controls.slint";

export component Library inherits Rectangle {
    background: Theme.canvas; border-top-left-radius: 12px;
    property <int> columns: clamp(floor((root.width - 220px) / 210px), 2, 20);
    changed columns => { Store.action("library-columns", root.columns); }
    VerticalLayout { spacing: 0px;
        Rectangle { height: 48px; background: Theme.panel; border-top-left-radius: 12px;
            HorizontalLayout { padding-left: 20px; padding-right: 20px; padding-top: 8px; padding-bottom: 8px; spacing: 8px;
                Text { text: "Crosshairs"; font-size: 14px * Theme.text-scale; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                ActionButton { text: "Import"; quiet: true; icon: @image-url("../../../../assets/icons/download.svg"); clicked => { Store.action("import", ""); } }
                ActionButton { text: "New"; primary: true; icon: @image-url("../../../../assets/icons/plus.svg"); clicked => { Store.action("new-preset", ""); } }
            }
            Divider { y: parent.height - 1px; }
        }
        Rectangle { height: 68px;
            HorizontalLayout { padding-left: 20px; padding-right: 20px; padding-top: 18px; padding-bottom: 18px; spacing: 12px;
                EditField { text: Store.search; placeholder: "Search crosshairs"; horizontal-stretch: 1; edited(value) => { Store.action("search", value); } }
                Text { text: "Sort"; color: Theme.muted; font-size: 11px * Theme.text-scale; vertical-alignment: center; }
                DropDown { width: 150px; model: ["Manual", "Name", "Recently edited"]; current-index: Store.sort; accessible-label: "Sort crosshairs"; selected(value) => { Store.action("sort", self.current-index); } }
            }
            Divider { y: parent.height - 1px; }
        }
        HorizontalLayout { spacing: 0px;
            Rectangle { width: 180px; background: Theme.panel;
                VerticalLayout { padding: 12px; spacing: 4px; alignment: start;
                    ActionButton { text: "All crosshairs"; icon: @image-url("../../../../assets/icons/crosshair.svg"); align-left: true; height: 38px; quiet: true; selected: !Store.favorites; horizontal-stretch: 1; clicked => { Store.action("favorites", "false"); } }
                    ActionButton { text: "Favorites"; icon: @image-url("../../../../assets/icons/star.svg"); align-left: true; height: 38px; quiet: true; selected: Store.favorites; horizontal-stretch: 1; clicked => { Store.action("favorites", "true"); } }
                }
                Text { y: parent.height - 42px; width: parent.width; height: 32px; text: Store.presets.length + " crosshairs"; color: Theme.muted; font-size: 11px * Theme.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.border; }
            }
            Rectangle {
                ListView { x: 20px; y: 20px; width: parent.width - 40px; height: parent.height - 40px;

            for group[row-index] in Store.preset-groups: Rectangle {
            height: 182px;
            for preset[column-index] in group.items: card := Rectangle {
                property <int> index: row-index * root.columns + column-index;
                property <length> stride: (parent.width - 12px) / root.columns;
                x: column-index * self.stride;
                width: (parent.width - 12px) / root.columns - 12px; height: 170px;
                background: card-focus.has-focus ? Theme.hover : Theme.field; border-radius: 12px; border-width: preset.selected || Store.preset-drop-index == self.index ? 1px : 0px; border-color: preset.selected || Store.preset-drop-index == self.index ? Theme.orange : Theme.border;
                accessible-role: button; accessible-label: preset.name; accessible-action-default => { Store.action("select-preset", preset.id); }
                Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 122px; background: transparent; border-radius: 12px;
                    Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: min(80px, preset.thumbnail.width * 1px); height: min(80px, preset.thumbnail.height * 1px); source: preset.thumbnail; image-fit: contain; image-rendering: pixelated; }
                    card-touch := TouchArea {
                        enabled: Store.modal-kind == 0 && !Store.read-only;
                        property <bool> dragging: false;
                        property <length> start-x;
                        property <length> start-y;
                        double-clicked => { Store.action("edit-preset", preset.id); }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.cancel { self.dragging = false; Store.dragged-preset = ""; Store.preset-drop-index = -1; }
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { self.start-x = self.mouse-x; self.start-y = self.mouse-y; self.dragging = false; card-focus.focus(); }
                            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                if self.dragging && Store.preset-drop-index >= 0 { Store.action("preset-drop", preset.id + ":" + Store.presets[Store.preset-drop-index].id); }
                                else { Store.action("select-preset", preset.id); }
                                self.dragging = false; Store.dragged-preset = ""; Store.preset-drop-index = -1;
                            }
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { Store.action("preset-menu", preset.id); }
                        }
                        moved => {
                            if self.pressed && Store.sort == 0 && (self.dragging || abs(self.mouse-x - self.start-x) + abs(self.mouse-y - self.start-y) > 6px) {
                                self.dragging = true; Store.dragged-preset = preset.id;
                                let column = clamp(floor((column-index * card.stride + self.mouse-x) / card.stride), 0, root.columns - 1);
                                let row = max(0, floor((row-index * 182px + self.mouse-y) / 182px));
                                Store.preset-drop-index = clamp(row * root.columns + column, 0, Store.presets.length - 1);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    y: 128px; height: 32px; padding-left: 12px; padding-right: 6px; spacing: 4px;
                    Text { text: preset.name; color: Theme.text; font-size: 12px * Theme.text-scale; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    ActionButton { icon: preset.favorite ? @image-url("../../../../assets/icons/star-filled.svg") : @image-url("../../../../assets/icons/star.svg"); accent-icon: preset.favorite; label: preset.favorite ? "Remove favorite" : "Favorite"; quiet: true; clicked => { Store.action("favorite", preset.id); } }
                    ActionButton { icon: @image-url("../../../../assets/icons/dots.svg"); label: "Crosshair actions"; quiet: true; clicked => { Store.action("preset-menu", preset.id); } }
                }
                card-focus := FocusScope { enabled: Store.modal-kind == 0 && !Store.read-only; focus-on-click: false; key-pressed(event) => { if event.text == "\n" { Store.action("edit-preset", preset.id); return accept; } if event.text == " " { Store.action("select-preset", preset.id); return accept; } return reject; } }
            }
            }
        }
            }
        }
    }
}
