import { ScrollView } from "std-widgets.slint";
import { Store, BindingRow } from "../shared/models.slint";
import { Theme } from "../shared/tokens.slint";
import { ActionButton, RenameField, SectionTitle } from "../shared/controls.slint";
import { DropDown } from "../shared/dropdown.slint";
import { PresetPicker } from "../shared/preset-picker.slint";

component AimActionEditor inherits Rectangle {
    in property <length> viewport-width;
    in property <length> viewport-height;
    property <bool> thumbnail-origin: false;
    property <bool> open-picker: false;
    preferred-width: 320px + (Store.aim-target != "" ? aim-thumbnail.width + 8px : 0px);
    Timer { interval: 1ms; running: root.open-picker; triggered => { root.open-picker = false; aim-picker.show(); } }
        aim-dropdown := DropDown {
            x: 0px; y: (root.height - self.height) / 2; width: root.width - (Store.aim-target != "" ? aim-thumbnail.width + 8px : 0px);
            enabled: Store.connected && Store.interactive;
            model: ["No action", "Toggle crosshair (Press)", "Hide crosshair (Hold)", "Show crosshair (Hold)", "Toggle saved crosshair (Press)", "Show saved crosshair (Hold)"];
            current-index: Store.aim-action; accessible-label: "Aim action";
            selected(index) => { Store.action("aim-action", "" + index); if index >= 4 { root.thumbnail-origin = false; root.open-picker = true; } }
        }
        aim-thumbnail := ActionButton {
            x: root.width - self.width; y: (root.height - self.height) / 2;
            visible: Store.aim-target != ""; width: self.height; height: aim-dropdown.height;
            thumbnail: Store.preset-thumbnails[Store.aim-target-index]; label: "Choose saved crosshair: " + Store.aim-target-name;
            clicked => { root.thumbnail-origin = true; Store.action("aim-action", "" + Store.aim-action); aim-picker.show(); }
        }
    aim-picker := PresetPicker {
        viewport-width: root.viewport-width; viewport-height: root.viewport-height;
        enabled: Store.connected && Store.interactive;
        model: Store.selector-presets; selected-id: Store.aim-target;
        total-count: Store.selector-total; favorite-count: Store.selector-favorite-count;
        chosen(id) => { Store.action("aim-target", id); }
        filter-request(search, favorites) => { Store.action("selector-filter", search); Store.action("selector-favorites", favorites ? "true" : "false"); }
        dismissed => { Store.action("aim-cancel", ""); if root.thumbnail-origin { aim-thumbnail.focus(); } else { aim-dropdown.focus(); } }
    }
}

component InputHeader inherits Rectangle {
    in property <bool> controller;
    in property <bool> heading;
    Rectangle { x: 0px; width: 1px; height: parent.height; background: Theme.border; }
    if root.heading: HorizontalLayout {
        alignment: center; spacing: 8px;
        Rectangle { width: 16px; Image { width: 16px; height: 16px; y: (parent.height - self.height) / 2;
            source: root.controller ? @image-url("../../../../assets/icons/device-gamepad-2.svg") : @image-url("../../../../assets/icons/device-desktop.svg"); colorize: Theme.muted;
        } }
        Text { text: root.controller ? "Controller" : "Keyboard / mouse"; font-size: 11px * Theme.text-scale; color: Theme.muted; vertical-alignment: center; }
    }
}

component ShortcutButton inherits ActionButton {
    primary: Theme.high-contrast && self.focus-visible;
    hover-color: self.primary ? Theme.orange : self.focus-visible ? Theme.hover : Theme.raised;
}

component DeleteColumn inherits Rectangle {
    in property <BindingRow> binding;
    in property <bool> pending;
    in property <bool> saving;
    width: 44px;
    Rectangle { x: 0px; width: 1px; height: parent.height; background: Theme.border; }
    if root.binding.shortcut: ShortcutButton {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 32px; quiet: true;
        enabled: Store.connected && Store.interactive && !root.saving;
        icon: @image-url("../../../../assets/icons/trash.svg");
        label: root.pending ? "Discard new shortcut" : "Delete shortcut for " + root.binding.name;
        clicked => { Store.action(root.pending ? "discard-shortcut" : "binding-remove", root.binding.id); }
    }
}

component TableHeader inherits Rectangle {
    in property <bool> application;
    height: 40px; vertical-stretch: 0; background: Theme.preview;
    border-top-left-radius: 9px; border-top-right-radius: 9px;
    HorizontalLayout { spacing: 0px;
        if !root.application: Text { text: "Crosshair"; color: Theme.muted; font-size: 11px * Theme.text-scale; width: 72px; vertical-alignment: center; horizontal-alignment: center; }
        if !root.application: Rectangle { width: 1px; background: Theme.border; }
        Rectangle { horizontal-stretch: 1; Text { x: 12px; text: root.application ? "Action" : "Shortcut name"; color: Theme.muted; font-size: 11px * Theme.text-scale; vertical-alignment: center; } }
        InputHeader { width: 26%; heading: true; }
        HorizontalLayout { width: 26%; spacing: 0px;
            InputHeader { horizontal-stretch: 1; heading: true; controller: true; }
            if !root.application: DeleteColumn {}
        }
    }
}

component TableRow inherits Rectangle {
    height: self.visible ? max(54px, 12px * Theme.text-scale + 32px) : 0px;
    vertical-stretch: 0;
}

component RecordShortcut inherits ShortcutButton {
    in property <BindingRow> binding;
    in property <bool> controller;
    in property <bool> saving;
    property <string> prompt: !root.controller ? "Press a key" : root.binding.direction == "" ? "Press or move a control" : "Press or move";
    out property <string> value: root.controller ? root.binding.controller : root.binding.chord;
    property <string> device-name: root.controller ? "Controller" : root.binding.direction != "" ? "Keyboard" : "Keyboard / mouse";
    property <string> target-name: root.binding.global ? root.binding.action : root.binding.name;
    property <string> display-value: root.value == "" ? "Unbound" : root.binding.enabled ? root.value : "Disabled: " + root.value;
    enabled: Store.connected && Store.interactive && !root.saving;
    selected: Store.capture-id == root.binding.id && Store.capture-controller == root.controller;
    text: root.saving ? "Saving…" : root.selected ? root.prompt : root.display-value;
    horizontal-padding: root.binding.direction != "" && root.value == "" ? 4px : 10px;
    text-color: root.value == "" && !root.selected && !root.saving ? Theme.muted : Theme.text;
    label: root.target-name + ", " + root.device-name + ": " + root.text;
    clicked => {
        if !root.selected {
            Store.capture-region(self.absolute-position.x / 1px, self.absolute-position.y / 1px, self.width / 1px, self.height / 1px);
            Store.action(root.controller ? "capture-controller" : "capture", root.binding.id);
        }
    }
}

component ClearShortcut inherits ShortcutButton {
    in property <BindingRow> binding;
    in property <bool> controller;
    icon: @image-url("../../../../assets/icons/x.svg");
    enabled: Store.connected && Store.interactive && (root.controller ? root.binding.controller != "" : root.binding.chord != "");
    label: "Clear " + (root.controller ? "controller" : root.binding.direction != "" ? "keyboard" : "keyboard / mouse") + " shortcut for " + (root.binding.global ? root.binding.action : root.binding.name);
    clicked => { Store.action(root.controller ? "clear-controller" : "clear-keyboard", root.binding.id); }
}

component ShortcutControls inherits TouchArea {
    in property <BindingRow> binding;
    in property <bool> controller;
    in property <bool> saving;
    in property <image> device-icon;
    in property <length> inset;
    property <bool> movement: root.binding.direction != "";
    property <bool> clearable: record.value != "";
    property <bool> highlighted: root.has-hover || record.focus-visible || clear.focus-visible;
    property <length> available-width: root.width - 2 * root.inset;
    out property <length> label-width: root.available-width - (root.clearable || root.movement ? clear.width + 4px : 0px);
    forward-focus: record;
    record := RecordShortcut {
        x: root.inset; y: (parent.height - self.height) / 2;
        width: root.clearable ? root.label-width : root.available-width;
        content-width: root.label-width;
        // During capture the clear button stays outside the recording hit target.
        background-width: root.movement && !self.selected ? min(self.content-width, max(32px, self.preferred-width)) : self.content-width;
        background-height: root.movement ? self.height - 6px : self.height;
        binding: root.binding; controller: root.controller; saving: root.saving;
        icon: root.device-icon; align-left: !root.movement;
        quiet: !root.highlighted;
    }
    clear := ClearShortcut {
        property <length> binding-right: record.x + (record.content-width + record.background-width) / 2;
        x: self.binding-right + 4px - (self.width - self.background-width) / 2;
        y: (parent.height - self.height) / 2;
        height: root.movement ? record.height : 32px; width: self.height;
        background-height: root.movement ? record.background-height : self.height;
        background-width: self.background-height;
        visible: root.clearable; opacity: root.highlighted && self.enabled ? 1 : 0;
        binding: root.binding; controller: root.controller;
    }
}

component ShortcutCell inherits ShortcutControls {
    inset: 8px;
    device-icon: root.controller ? @image-url("../../../../assets/icons/device-gamepad-2.svg") : root.binding.mouse ? @image-url("../../../../assets/icons/mouse.svg") : @image-url("../../../../assets/icons/keyboard.svg");
    Rectangle { x: 0px; width: 1px; height: parent.height; background: Theme.border; }
}

component MovementGrid inherits Rectangle {
    property <length> header-height: max(32px, 12px * Theme.text-scale + 12px);
    property <length> row-height: max(38px, 12px * Theme.text-scale + 20px);
    height: root.header-height + 2 * root.row-height; vertical-stretch: 0;
    Rectangle { y: 0px; height: root.header-height; background: Theme.preview; }
    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
        VerticalLayout {
            width: 22%;
            Text { height: root.header-height; text: "Movement"; color: Theme.text; font-size: 12px * Theme.text-scale; font-weight: 600; vertical-alignment: center; }
            for controller in [false, true]: HorizontalLayout {
                height: root.row-height; alignment: start; spacing: 8px;
                Rectangle { width: 16px; Image {
                    y: (parent.height - self.height) / 2; width: 16px; height: 16px; colorize: Theme.muted;
                    source: controller ? @image-url("../../../../assets/icons/device-gamepad-2.svg") : @image-url("../../../../assets/icons/keyboard.svg");
                } }
                Text { text: controller ? "Controller" : "Keyboard"; color: Theme.muted; font-size: 12px * Theme.text-scale; vertical-alignment: center; }
            }
        }
        for binding in Store.movement-bindings: VerticalLayout {
            min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
            Rectangle {
                height: root.header-height;
                HorizontalLayout {
                    x: 0px; width: keyboard.label-width; alignment: center; spacing: 4px;
                    Rectangle { width: 16px * Theme.text-scale;
                        Image {
                            width: parent.width; height: self.width; y: (parent.height - self.height) / 2;
                            colorize: Theme.muted;
                            source: binding.id == "forward" ? @image-url("../../../../assets/icons/square-arrow-up.svg")
                                : binding.id == "left" ? @image-url("../../../../assets/icons/square-arrow-left.svg")
                                : binding.id == "backward" ? @image-url("../../../../assets/icons/square-arrow-down.svg")
                                : @image-url("../../../../assets/icons/square-arrow-right.svg");
                        }
                    }
                    Text { text: binding.direction; color: Theme.muted; font-size: 11px * Theme.text-scale; vertical-alignment: center; }
                }
            }
            keyboard := ShortcutControls { height: root.row-height; binding: binding; }
            ShortcutControls { height: root.row-height; binding: binding; controller: true; }
        }
    }
    Rectangle { y: 0px; height: 1px; width: parent.width; background: Theme.border; }
    Rectangle { y: root.header-height; height: 1px; width: parent.width; background: Theme.border; }
    Rectangle { y: root.header-height + root.row-height; height: 1px; width: parent.width; background: Theme.border; }
}

component BindingItem inherits TableRow {
    in property <BindingRow> binding;
    in property <bool> pending: false;
    property <bool> saving: root.pending && Store.pending-shortcut != "new-shortcut";
    in property <length> viewport-width;
    in property <length> viewport-height;
    public function focus-shortcut() { keyboard.focus(); }
    clip: true;
    HorizontalLayout { spacing: 0px;
        if root.binding.global: Rectangle { horizontal-stretch: 1;
            Text { x: 12px; width: root.binding.id == "aim" ? 60px : parent.width - 24px; text: root.binding.action; color: Theme.text; font-size: 12px * Theme.text-scale; vertical-alignment: center; }
            if root.binding.id == "aim": AimActionEditor { x: parent.width - self.width - 12px; y: (parent.height - self.height) / 2; height: max(36px, 12px * Theme.text-scale + 16px); width: min(self.preferred-width, max(0px, parent.width - 76px)); viewport-width: root.viewport-width; viewport-height: root.viewport-height; }
        }
        if root.binding.shortcut: Rectangle { width: 72px;
            trigger := ActionButton { x: 16px; y: (parent.height - self.height) / 2; width: 40px; height: 40px; enabled: Store.connected && Store.interactive && !root.saving; thumbnail: Store.preset-thumbnails[root.binding.target-index]; label: "Choose crosshair for " + root.binding.name; clicked => { picker.show(); } }
            picker := PresetPicker {
                viewport-width: root.viewport-width; viewport-height: root.viewport-height;
                model: Store.selector-presets; selected-id: root.binding.target;
                total-count: Store.selector-total; favorite-count: Store.selector-favorite-count;
                chosen(id) => { Store.action(root.pending ? "preset-keybind" : "binding-target-id", root.pending ? id : root.binding.id + ":" + id); }
                filter-request(search, favorites) => { Store.action("selector-filter", search); Store.action("selector-favorites", favorites ? "true" : "false"); }
                dismissed => { trigger.focus(); }
            }
        }
        if root.binding.shortcut: Rectangle { width: 1px; background: Theme.border; }
        if root.binding.shortcut: Rectangle { horizontal-stretch: 1;
            if root.pending: Text { x: 12px; width: parent.width - 24px; text: root.binding.name; color: Theme.text; font-size: 12px * Theme.text-scale; vertical-alignment: center; overflow: elide; }
            if !root.pending: RenameField { x: 6px; y: (parent.height - self.height) / 2; width: parent.width - 12px; value: root.binding.name; label: "Rename shortcut"; committed(value) => { Store.action("binding-name", root.binding.id + ":" + value); } }
        }
        keyboard := ShortcutCell { width: 26%; binding: root.binding; saving: root.saving; }
        HorizontalLayout { width: 26%; spacing: 0px;
            ShortcutCell { horizontal-stretch: 1; binding: root.binding; controller: true; saving: root.saving; }
            if root.binding.shortcut: DeleteColumn { binding: root.binding; pending: root.pending; saving: root.saving; }
        }
    }
    Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.border; }
}

export component Keybinds inherits Rectangle {
    background: Theme.canvas; border-top-left-radius: 12px;
    Timer { interval: 16ms; running: Store.request-shortcut;
        triggered => { if Store.capture-id == "" { pending-shortcut.focus-shortcut(); } Store.request-shortcut = false; }
    }
    ScrollView { horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
        VerticalLayout { padding: 24px; spacing: 12px; alignment: start;
            HorizontalLayout {
                Text { text: "Keybinds"; color: Theme.text; font-size: 15px * Theme.text-scale; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
                ActionButton { icon: @image-url("../../../../assets/icons/info-circle.svg"); label: "Shortcut help"; quiet: true; clicked => { Store.action("input-help", ""); } }
            }
            if Store.controller-error != "": Text { text: Store.controller-error; color: Theme.text; font-size: 12px * Theme.text-scale; wrap: word-wrap; }
            SectionTitle { text: "ACTIONS"; }
            Rectangle { vertical-stretch: 0; background: Theme.panel; border-radius: 10px; clip: true; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 1px; spacing: 0px;
                    TableHeader { application: true; }
                    for binding in Store.bindings: BindingItem { viewport-width: root.width + root.absolute-position.x; viewport-height: root.height + root.absolute-position.y; binding: binding; visible: binding.global; }
                    if Store.movement-bindings.length > 0: MovementGrid {}
                }
            }
            SectionTitle { text: "CROSSHAIR SHORTCUTS"; }
            Rectangle { vertical-stretch: 0; background: Theme.panel; border-radius: 10px; clip: true; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 1px; spacing: 0px;
                    TableHeader {}
                    TableRow {
                        HorizontalLayout { spacing: 0px;
                            Rectangle { width: 72px;
                                ActionButton { x: 20px; y: (parent.height - self.height) / 2; width: 32px; icon: @image-url("../../../../assets/icons/plus.svg"); accent-icon: true; label: "Choose crosshair for new shortcut"; quiet: true; clicked => { new-picker.show(); } }
                            }
                            Rectangle { width: 1px; background: Theme.border; }
                            Rectangle { horizontal-stretch: 1;
                                new-shortcut := ActionButton { x: 6px; y: (parent.height - self.height) / 2; width: 64px; text: "New"; label: "New crosshair shortcut"; align-left: true; quiet: true; clicked => { new-picker.show(); } }
                            }
                            InputHeader { width: 26%; }
                            HorizontalLayout { width: 26%; spacing: 0px;
                                InputHeader { horizontal-stretch: 1; }
                                DeleteColumn {}
                            }
                        }
                        Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.border; }
                    }
                    pending-shortcut := BindingItem {
                        pending: true; visible: Store.pending-shortcut != "";
                        viewport-width: root.width + root.absolute-position.x; viewport-height: root.height + root.absolute-position.y;
                        binding: { id: "new-shortcut", name: Store.preset-names[Store.target-index], target: Store.pending-preset, target-index: Store.target-index, enabled: true, shortcut: true };
                    }
                    for binding in Store.bindings: BindingItem { viewport-width: root.width + root.absolute-position.x; viewport-height: root.height + root.absolute-position.y; binding: binding; visible: binding.shortcut; }
                }
            }
        }
    }
    new-picker := PresetPicker {
        viewport-width: root.width + root.absolute-position.x; viewport-height: root.height + root.absolute-position.y;
        model: Store.selector-presets; total-count: Store.selector-total; favorite-count: Store.selector-favorite-count;
        chosen(id) => { Store.action("preset-keybind", id); }
        filter-request(search, favorites) => { Store.action("selector-filter", search); Store.action("selector-favorites", favorites ? "true" : "false"); }
        dismissed => { new-shortcut.focus(); }
    }
}
