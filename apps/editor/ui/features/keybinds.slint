import { ScrollView } from "std-widgets.slint";
import { Store, BindingRow } from "../shared/models.slint";
import { Theme } from "../shared/tokens.slint";
import { ActionButton, RenameField, SectionTitle } from "../shared/controls.slint";
import { DropDown } from "../shared/dropdown.slint";
import { PresetPicker } from "../shared/preset-picker.slint";

component AimActionEditor inherits Rectangle {
    in property <length> viewport-width;
    in property <length> viewport-height;
    property <bool> thumbnail-origin: false;
    property <bool> open-picker: false;
    preferred-width: 320px + (Store.aim-target != "" ? aim-thumbnail.width + 8px : 0px);
    Timer { interval: 1ms; running: root.open-picker; triggered => { root.open-picker = false; aim-picker.show(); } }
        aim-dropdown := DropDown {
            x: 0px; y: (root.height - self.height) / 2; width: root.width - (Store.aim-target != "" ? aim-thumbnail.width + 8px : 0px);
            enabled: Store.connected && Store.interactive;
            model: ["No action", "Toggle crosshair (Press)", "Hide crosshair (Hold)", "Show crosshair (Hold)", "Toggle saved crosshair (Press)", "Show saved crosshair (Hold)"];
            current-index: Store.aim-action; accessible-label: "Aim action";
            selected(index) => { Store.action("aim-action", "" + index); if index >= 4 { root.thumbnail-origin = false; root.open-picker = true; } }
        }
        aim-thumbnail := ActionButton {
            x: root.width - self.width; y: (root.height - self.height) / 2;
            visible: Store.aim-target != ""; width: self.height; height: aim-dropdown.height;
            thumbnail: Store.preset-thumbnails[Store.aim-target-index]; label: "Choose saved crosshair: " + Store.aim-target-name;
            clicked => { root.thumbnail-origin = true; Store.action("aim-action", "" + Store.aim-action); aim-picker.show(); }
        }
    aim-picker := PresetPicker {
        viewport-width: root.viewport-width; viewport-height: root.viewport-height;
        enabled: Store.connected && Store.interactive;
        model: Store.selector-presets; selected-id: Store.aim-target;
        total-count: Store.selector-total; favorite-count: Store.selector-favorite-count;
        chosen(id) => { Store.action("aim-target", id); }
        filter-request(search, favorites) => { Store.action("selector-filter", search); Store.action("selector-favorites", favorites ? "true" : "false"); }
        dismissed => { Store.action("aim-cancel", ""); if root.thumbnail-origin { aim-thumbnail.focus(); } else { aim-dropdown.focus(); } }
    }
}

component TableHeader inherits Rectangle {
    in property <bool> application: false;
    height: 40px; vertical-stretch: 0; background: Theme.preview;
    border-top-left-radius: 9px; border-top-right-radius: 9px;
    HorizontalLayout { spacing: 0px;
        if root.application: Rectangle { horizontal-stretch: 1; Text { x: 12px; width: parent.width - 24px; text: "Action"; color: Theme.muted; font-size: 11px * Theme.text-scale; vertical-alignment: center; } }
        if !root.application: Text { text: "Crosshair"; color: Theme.muted; font-size: 11px * Theme.text-scale; width: 88px; vertical-alignment: center; horizontal-alignment: center; }
        if !root.application: Rectangle { width: 1px; background: Theme.border; }
        if !root.application: Rectangle { horizontal-stretch: 1; Text { x: 12px; width: parent.width - 24px; text: "Shortcut name"; color: Theme.muted; font-size: 11px * Theme.text-scale; vertical-alignment: center; } }
        Rectangle { width: 1px; background: Theme.border; }
        Text { text: "Keyboard / mouse"; color: Theme.muted; font-size: 11px * Theme.text-scale; width: 254px; vertical-alignment: center; horizontal-alignment: center; }
        Rectangle { width: 1px; background: Theme.border; }
        Rectangle { width: 52px; }
    }
}

component BindingItem inherits Rectangle {
    in property <BindingRow> binding;
    in property <bool> pending: false;
    property <bool> saving: root.pending && Store.pending-shortcut != "new-shortcut";
    in property <length> viewport-width;
    in property <length> viewport-height;
    public function record() {
        capture-button.focus();
        Store.capture-region(capture-button.absolute-position.x / 1px, capture-button.absolute-position.y / 1px, capture-button.width / 1px, capture-button.height / 1px);
        Store.action(root.pending ? "new-binding" : "capture", root.pending ? "5" : root.binding.id);
    }
    height: max(56px, 12px * Theme.text-scale + 32px); vertical-stretch: 0; clip: true;
    HorizontalLayout { spacing: 0px;
        if root.binding.global: Rectangle { horizontal-stretch: 1;
            Text { x: 12px; width: root.binding.id == "aim" ? 88px : parent.width - 80px; text: root.binding.action; color: Theme.text; font-size: 12px * Theme.text-scale; vertical-alignment: center; }
            if root.binding.id == "aim": AimActionEditor { x: parent.width - self.width - 12px; y: (parent.height - self.height) / 2; height: max(36px, 12px * Theme.text-scale + 16px); width: min(self.preferred-width, max(0px, parent.width - 124px)); viewport-width: root.viewport-width; viewport-height: root.viewport-height; }
        }
        if root.binding.shortcut: Rectangle { width: 88px;
            trigger := ActionButton { x: 24px; y: (parent.height - self.height) / 2; width: 40px; height: 40px; enabled: Store.connected && Store.interactive && !root.saving; thumbnail: Store.preset-thumbnails[root.binding.target-index]; label: "Choose crosshair for " + root.binding.name; clicked => { picker.show(); } }
            picker := PresetPicker {
                viewport-width: root.viewport-width; viewport-height: root.viewport-height;
                model: Store.selector-presets; selected-id: root.binding.target;
                total-count: Store.selector-total; favorite-count: Store.selector-favorite-count;
                chosen(id) => { Store.action(root.pending ? "preset-keybind" : "binding-target-id", root.pending ? id : root.binding.id + ":" + id); }
                filter-request(search, favorites) => { Store.action("selector-filter", search); Store.action("selector-favorites", favorites ? "true" : "false"); }
                dismissed => { trigger.focus(); }
            }
        }
        if root.binding.shortcut: Rectangle { width: 1px; background: Theme.border; }
        if root.binding.shortcut: Rectangle { horizontal-stretch: 1;
            if root.pending: Text { x: 14px; width: parent.width - 28px; text: root.binding.name; color: Theme.text; font-size: 12px * Theme.text-scale; vertical-alignment: center; overflow: elide; }
            if !root.pending: RenameField { x: 6px; y: (parent.height - self.height) / 2; width: parent.width - 12px; value: root.binding.name; label: "Rename shortcut"; committed(value) => { Store.action("binding-name", root.binding.id + ":" + value); } }
        }
        Rectangle { width: 1px; background: Theme.border; }
        Rectangle { width: 254px;
            capture-button := ActionButton { x: 12px; y: (parent.height - self.height) / 2; width: 230px; align-left: true;
                enabled: Store.connected && Store.interactive && !root.saving;
                text: root.saving ? "Saving…" : root.pending || Store.capture-id == root.binding.id ? "Press a key" : !root.binding.global && !root.binding.enabled ? "Disabled: " + root.binding.chord : root.binding.chord;
                icon: @image-url("../../../../assets/icons/keyboard.svg"); selected: Store.capture-id == root.binding.id;
                clicked => { if Store.capture-id != root.binding.id { root.record(); } }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        Rectangle { width: 52px;
            ActionButton { x: 10px; y: (parent.height - self.height) / 2; width: 32px; enabled: Store.connected && Store.interactive && !root.saving; icon: root.pending ? @image-url("../../../../assets/icons/x.svg") : @image-url("../../../../assets/icons/trash.svg"); label: root.pending ? "Discard new shortcut" : root.binding.global ? "Clear " + root.binding.action + " shortcut" : "Remove shortcut"; quiet: true; clicked => { Store.action(root.pending ? "discard-shortcut" : "binding-remove", root.pending ? "" : root.binding.id); } }
        }
    }
    Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.border; }

}

export component Keybinds inherits Rectangle {
    background: Theme.canvas; border-top-left-radius: 12px;
    Timer { interval: 16ms; running: Store.request-shortcut;
        triggered => { pending-shortcut.record(); Store.request-shortcut = false; }
    }
    ScrollView { horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
        VerticalLayout { padding: 24px; spacing: 12px; alignment: start;
            HorizontalLayout {
                Text { text: "Keybinds"; color: Theme.text; font-size: 15px * Theme.text-scale; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
                ActionButton { icon: @image-url("../../../../assets/icons/info-circle.svg"); label: "Shortcut help"; quiet: true; clicked => { Store.action("input-help", ""); } }
            }
            SectionTitle { text: "ACTIONS · " + Store.action-profile; }
            Rectangle { vertical-stretch: 0; background: Theme.panel; border-radius: 10px; clip: true; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 1px; spacing: 0px;
                    TableHeader { application: true; }
                    for binding in Store.bindings: BindingItem { viewport-width: root.width + root.absolute-position.x; viewport-height: root.height + root.absolute-position.y; binding: binding; visible: binding.global; height: self.visible ? max(56px, 12px * Theme.text-scale + 32px) : 0px; }
                    if Store.movement-bindings.length > 0: Rectangle {
                        height: max(44px, 12px * Theme.text-scale + 24px); vertical-stretch: 0;
                        Rectangle { y: 0px; height: 1px; width: parent.width; background: Theme.border; }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px;
                            Text { text: "Movement"; color: Theme.text; font-size: 12px * Theme.text-scale; horizontal-stretch: 1; vertical-alignment: center; }
                            Rectangle {
                                preferred-width: segments.preferred-width; horizontal-stretch: 0;
                                height: max(32px, 12px * Theme.text-scale + 16px); y: (parent.height - self.height) / 2;
                                background: Theme.field; border-radius: Theme.radius; clip: true;
                                segments := HorizontalLayout { spacing: 0px;
                                    for binding[index] in Store.movement-bindings: Rectangle {
                                        preferred-width: min(164px, max(112px, key.preferred-width + 32px)); min-width: 56px;
                                        property <bool> show-clear: binding.enabled && (key.hovered || clear.hovered || key.focus-visible || clear.focus-visible);
                                        if index > 0: Rectangle { x: 0px; y: 8px; width: 1px; height: parent.height - 16px; background: Theme.border; }
                                        key := ActionButton {
                                            x: 1px; width: parent.width - 1px - (parent.show-clear ? 32px : 0px); quiet: true;
                                            enabled: Store.connected && Store.interactive;
                                            text: Store.capture-id == binding.id ? "Press a key" : binding.direction + "  " + binding.chord;
                                            label: binding.action + ": " + binding.chord; selected: Store.capture-id == binding.id;
                                            clicked => { if Store.capture-id != binding.id {
                                                Store.capture-region(self.absolute-position.x / 1px, self.absolute-position.y / 1px, self.width / 1px, self.height / 1px);
                                                Store.action("capture", binding.id);
                                            } }
                                        }
                                        clear := ActionButton {
                                            x: parent.width - self.width; width: 32px; opacity: parent.show-clear ? 1 : 0; quiet: true;
                                            icon: @image-url("../../../../assets/icons/trash.svg"); label: "Clear " + binding.action + " shortcut";
                                            enabled: Store.connected && Store.interactive && binding.enabled;
                                            clicked => { Store.action("binding-remove", binding.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            SectionTitle { text: "CROSSHAIR SHORTCUTS"; }
            Rectangle { vertical-stretch: 0; background: Theme.panel; border-radius: 10px; clip: true; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 1px; spacing: 0px;
                    TableHeader {}
                    Rectangle { height: max(56px, 12px * Theme.text-scale + 32px); vertical-stretch: 0;
                        HorizontalLayout { spacing: 0px;
                            Rectangle { width: 88px;
                                ActionButton { x: 28px; y: (parent.height - self.height) / 2; width: 32px; icon: @image-url("../../../../assets/icons/plus.svg"); accent-icon: true; label: "Choose crosshair for new shortcut"; quiet: true; clicked => { new-picker.show(); } }
                            }
                            Rectangle { width: 1px; background: Theme.border; }
                            Rectangle { horizontal-stretch: 1;
                                new-shortcut := ActionButton { x: 6px; y: (parent.height - self.height) / 2; width: 64px; text: "New"; label: "New crosshair shortcut"; align-left: true; quiet: true; clicked => { new-picker.show(); } }
                            }
                            Rectangle { width: 1px; background: Theme.border; }
                            Rectangle { width: 254px; }
                            Rectangle { width: 1px; background: Theme.border; }
                            Rectangle { width: 52px; }
                        }
                        Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.border; }
                    }
                    pending-shortcut := BindingItem {
                        pending: true;
                        visible: Store.pending-shortcut != "";
                        height: self.visible ? max(56px, 12px * Theme.text-scale + 32px) : 0px;
                        viewport-width: root.width + root.absolute-position.x; viewport-height: root.height + root.absolute-position.y;
                        binding: { direction: "", id: "new-shortcut", name: Store.preset-names[Store.target-index], action: "", target: "", target-index: Store.target-index, chord: "", enabled: true, shortcut: true, global: false };
                    }
                    for binding in Store.bindings: BindingItem { viewport-width: root.width + root.absolute-position.x; viewport-height: root.height + root.absolute-position.y; binding: binding; visible: binding.shortcut; height: binding.shortcut ? max(56px, 12px * Theme.text-scale + 32px) : 0px; }
                }
            }
        }
    }
    new-picker := PresetPicker {
        viewport-width: root.width + root.absolute-position.x; viewport-height: root.height + root.absolute-position.y;
        model: Store.selector-presets; total-count: Store.selector-total; favorite-count: Store.selector-favorite-count;
        chosen(id) => { Store.action("preset-keybind", id); }
        filter-request(search, favorites) => { Store.action("selector-filter", search); Store.action("selector-favorites", favorites ? "true" : "false"); }
        dismissed => { new-shortcut.focus(); }
    }
}
