import { ScrollView } from "std-widgets.slint";
import { Store } from "../shared/models.slint";
import { Theme } from "../shared/tokens.slint";
import { ActionButton, EditField } from "../shared/controls.slint";

export component Modal inherits Rectangle {
    background: #00000080;
    init => { modal-keys.focus(); }
    modal-keys := FocusScope {
    focus-on-click: false; focus-on-tab-navigation: false;
    key-pressed(event) => {
        if event.text == Key.Escape { Store.action("modal-cancel", ""); return accept; }
        if event.text == Key.Return && Store.modal-kind != 4 { Store.action("modal-confirm", Store.modal-text); return accept; }
        return reject;
    }
    TouchArea { clicked => { if Store.modal-kind == 4 { Store.action("modal-cancel", ""); } } }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(500px * Theme.text-scale, parent.width - 48px); height: min(root.height - 48px, content.preferred-height);
        background: Theme.panel; border-width: 1px; border-color: Theme.border; border-radius: 12px;
        content := VerticalLayout {
            padding: 20px; spacing: 16px;
            Text { text: Store.modal-title; color: Theme.text; font-size: 16px * Theme.text-scale; font-weight: 600; height: 24px * Theme.text-scale; vertical-stretch: 0; }
            if Store.modal-message != "": message-scroll := ScrollView { horizontal-scrollbar-policy: always-off; content-width: self.visible-width; height: min(message.preferred-height + 4px, root.height - 240px); message := Text { width: message-scroll.visible-width - 12px; text: Store.modal-message; color: Theme.muted; font-size: 12px * Theme.text-scale; wrap: word-wrap; } }
            if Store.modal-kind == 2: EditField { enabled: true; text <=> Store.modal-text; label: Store.modal-title; accepted(value) => { Store.action("modal-confirm", value); } }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                if Store.modal-alternate != "": ActionButton { enabled: true; text: Store.modal-alternate; clicked => { Store.action("modal-alternate", ""); } }
                ActionButton { enabled: true; text: Store.modal-kind == 4 ? "Close" : "Cancel"; clicked => { Store.action("modal-cancel", ""); } }
                if Store.modal-kind != 4: ActionButton { enabled: true; text: Store.modal-confirm; primary: true; clicked => { Store.action("modal-confirm", Store.modal-text); } }
            }
        }
    }
    }
}
