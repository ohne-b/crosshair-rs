import "../../../assets/fonts/Manrope.ttf";
import { Store } from "shared/models.slint";
import { Theme } from "shared/tokens.slint";
import { ActionButton, ImportPanel } from "shared/controls.slint";
import { ScrollView } from "std-widgets.slint";
import { TitleBar } from "shell/titlebar.slint";
import { Navigation } from "shell/navigation.slint";
import { Modal } from "shell/modal.slint";
import { MenuPanel } from "shared/menu.slint";
import { Library } from "features/library.slint";
import { Designer } from "features/designer.slint";
import { Keybinds } from "features/keybinds.slint";
import { Settings } from "features/settings.slint";
export { Store, StartupRead, PresetRow, PresetGroup, LayerRow, FieldRow, FieldGroup, BindingRow, SelectionBounds, CanvasTile } from "shared/models.slint";
export { Theme } from "shared/tokens.slint";

export component AppWindow inherits Window {
    title: "crosshair-editor";
    icon: @image-url("../../../packaging/windows/Assets/Square150x150Logo.png");
    preferred-width: 1280px; preferred-height: 800px;
    min-width: min(960px, Store.work-width * 1px); min-height: min(640px, Store.work-height * 1px);
    background: transparent;
    default-font-family: "Manrope"; default-font-size: 13px * Theme.text-scale;
    forward-focus: keys;
    public function finish-input() { keys.focus(); }
    property <int> import-page: Store.modal-kind == 0 && !Store.read-only && (Store.page != 0 || !Store.browsing) ? Store.page : -1;
    changed import-page => { import-popup.close(); }
    in property <bool> dragging-import-file;
    callback file-pointer() -> { x: float, y: float };
    property <length> import-width: min(280px * Theme.text-scale, root.width - 16px);
    property <length> import-height: max(176px, 104px + 56px * Theme.text-scale);
    property <length> import-left: clamp(Store.menu-x * 1px - (root.import-page == 1 ? root.import-width / 2 : root.import-width), 8px, root.width - root.import-width - 8px);
    property <length> import-top: clamp(Store.menu-y * 1px - (root.import-page == 1 ? root.import-height : 0px), 8px, root.height - root.import-height - 8px);
    function over-import() -> bool {
        if !import-popup.is-open { return false; }
        let p = root.file-pointer();
        return p.x * 1px >= root.import-left && p.x * 1px < root.import-left + root.import-width
            && p.y * 1px >= root.import-top && p.y * 1px < root.import-top + root.import-height;
    }
    property <bool> drop-hover;
    property <bool> track-file: root.dragging-import-file && import-popup.is-open;
    changed track-file => { root.drop-hover = root.track-file && root.over-import(); }
    // Windows reports file enter/leave, but sends no pointer moves during an Explorer drag.
    Timer { running: root.track-file; interval: 25ms; triggered => { root.drop-hover = root.over-import(); } }
    public function file-dropped(path: string, supported: bool) {
        if root.import-page != 0 && root.import-page != 1 { return; }
        if import-popup.is-open {
            if supported && root.over-import() {
                import-popup.close();
                Store.action(root.import-page == 1 ? "drop-image" : "import", path);
            }
        } else if root.import-page == 1 {
            Store.action("drop-image", path);
        }
    }
    property <int> modal-kind: Store.modal-kind;
    property <bool> menu-open: menu.is-open;
    property <bool> help-open: help.is-open;
    property <bool> startup-visible: Store.connected && !Store.read-only && Store.page == 3 && Store.settings-category == 1;
    changed startup-visible => { if root.startup-visible { Store.action("read-startup", ""); } }
    changed modal-kind => {
        if root.modal-kind == 3 { menu.show(); } else { menu.close(); }
        if root.modal-kind == 5 { help.show(); } else { help.close(); }
    }
    changed menu-open => { if !root.menu-open && Store.modal-kind == 3 { Store.action("modal-cancel", ""); } }
    changed help-open => { if !root.help-open && Store.modal-kind == 5 { Store.action("modal-cancel", ""); } }
    import-popup := PopupWindow {
        x: root.import-left; y: root.import-top; width: root.import-width; height: root.import-height;
        close-policy: close-on-click-outside; forward-focus: import-panel;
        import-panel := ImportPanel {
            icon: root.import-page == 1 ? @image-url("../../../assets/icons/photo.svg") : @image-url("../../../assets/icons/folder.svg");
            highlighted: root.drop-hover;
            instruction: root.import-page == 1 ? "Drop an image here" : "Drop a crosshair file here";
            formats: root.import-page == 1 ? "PNG, JPEG, SVG or the first GIF frame" : ".json or .crosshair";
            browse => { import-popup.close(); Store.action(root.import-page == 1 ? "add-image" : "import", ""); }
        }
    }
    menu := PopupWindow {
        x: clamp(Store.menu-x * 1px, 8px, root.width - self.width - 8px);
        y: clamp(Store.menu-y * 1px, 48px, root.height - self.height - 8px);
        width: min(240px * Theme.text-scale, root.width - 16px);
        height: min(root.height - 64px, Store.modal-options.length * max(32px, 12px * Theme.text-scale + 16px) + 8px);
        close-policy: close-on-click-outside;
        forward-focus: menu-panel;
        menu-panel := MenuPanel {}
    }
    help := PopupWindow {
        x: clamp(Store.menu-x * 1px, 8px, root.width - self.width - 8px);
        y: clamp(Store.menu-y * 1px, 48px, root.height - self.height - 8px);
        width: min(360px * Theme.text-scale, root.width - 16px);
        height: min(root.height - 64px, help-text.preferred-height + 56px);
        close-policy: close-on-click-outside;
        forward-focus: help-keys;
        Rectangle {
            background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            Text { x: 16px; y: 12px; width: parent.width - 32px; height: 20px; text: Store.modal-title; color: Theme.text; font-size: 12px * Theme.text-scale; font-weight: 600; }
            help-scroll := ScrollView {
                x: 16px; y: 40px; width: parent.width - 32px; height: parent.height - 56px;
                horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                help-text := Text { width: help-scroll.visible-width - 8px; text: Store.modal-message; color: Theme.muted; font-size: 12px * Theme.text-scale; wrap: word-wrap; }
            }
            help-keys := FocusScope { focus-on-click: false; key-pressed(event) => { if event.text == Key.Escape { Store.action("modal-cancel", ""); return accept; } return reject; } }
        }
    }
    changed width => { Store.wide = root.width > 1056px; }
    Rectangle { x: 0px; y: 48px; width: root.width; height: root.height - 48px; background: Theme.panel; }
    keys := FocusScope {
    width: root.width; height: root.height;
    focus-on-click: false;
    focus-on-tab-navigation: false;
    Rectangle { width: root.width; height: root.height;
    VerticalLayout {
        spacing: 0px;
        TitleBar { z: 1; }
        HorizontalLayout {
            spacing: 0px;
            Navigation {}
            Rectangle { border-top-left-radius: 13px; clip: true; background: Theme.border;
            VerticalLayout {
                padding-left: 1px; padding-top: 1px; spacing: 0px;
                if Store.activity != "": Rectangle { height: 28px; background: Theme.panel; Text { x: 16px; text: Store.activity; color: Theme.muted; font-size: 12px * Theme.text-scale; vertical-alignment: center; } }
                if Store.error != "": Rectangle {
                    height: max(44px, warning-content.preferred-height); vertical-stretch: 0; background: #382821; border-top-left-radius: Store.activity == "" ? 12px : 0px;
                    warning-content := HorizontalLayout { padding-left: 16px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 8px;
                        Text { text: Store.error; color: #FED7AA; font-size: 12px * Theme.text-scale; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        if !Store.connected: Rectangle { width: reconnect.preferred-width; min-height: reconnect.height; reconnect := ActionButton { y: (parent.height - self.height) / 2; text: "Reconnect"; clicked => { Store.action("reconnect", ""); } } }
                        if Store.save-paused: Rectangle { width: retry.preferred-width; min-height: retry.height; retry := ActionButton { y: (parent.height - self.height) / 2; text: "Retry"; clicked => { Store.action("retry-edit", ""); } } }
                        Rectangle { width: 32px; min-height: 32px; ActionButton { y: (parent.height - self.height) / 2; icon: @image-url("../../../assets/icons/x.svg"); label: "Dismiss message"; quiet: true; clicked => { Store.action("dismiss-error", ""); } } }
                    }
                }
                Rectangle { background: Store.error != "" ? #382821 : transparent;
                if Store.page == 0: Library { import-requested => { import-popup.show(); } }
                if Store.page == 1: Designer { import-requested => { import-popup.show(); } }
                if Store.page == 2: Keybinds {}
                if Store.page == 3: Settings {}
                }
            }
            }
        }
    }
    }
        key-pressed(event) => {
            Store.keyboard-navigation = true;
            if Store.shortcut(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) { return accept; }
            return reject;
        }
    if Store.modal-kind == 1 || Store.modal-kind == 2 || Store.modal-kind == 4: Modal {}
    }
}
